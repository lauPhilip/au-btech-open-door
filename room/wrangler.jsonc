// Cloudflare Worker that serves the app and hosts the live session rooms.
// Free plan: rooms are SQLite-backed Durable Objects (see docs/decisions/0001-tech-stack.md).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "open-door",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "HelloRoom", "class_name": "HelloRoom" },
      { "name": "GameRoom", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HelloRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["GameRoom"] }
  ],
  // Shared across all copies of the Worker: at most 10 new sessions per minute per address.
  // The Worker also limits in memory, so it still works where this binding is missing.
  "ratelimits": [{ "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true }
}
